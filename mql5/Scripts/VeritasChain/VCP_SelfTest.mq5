   Expect("iso s", VcpIsoFromNs(StringToInteger("1791504000000000000"), 0), "2026-10-09T00:00:00Z");
   string u = VcpUuid7(StringToInteger("1250999896491"));
   ExpectTrue("uuid7 shape", StringLen(u) == 36 && StringSubstr(u, 14, 1) == "7" && StringSubstr(u, 0, 13) == "01234567-89ab");
   //--- Merkle (leaves are SHA-256 of the decimal strings 0..23)
   string leaves[];
   ArrayResize(leaves, 24);
   for(int i = 0; i < 24; i++) { uchar d[], h[]; VcpUtf8(IntegerToString(i), d); VcpSha256(d, h); leaves[i] = VcpHex(h); }
   Expect("leaf 0", leaves[0], "5feceb66ffc86f38d952786c6d696c79c2dbc239dd4e91b46729d73a27fb57e9");
   Expect("leaf 23", leaves[23], "535fa30d7e25dd8a49f1536779734ec8286108d115da5045d77f3b4185d8f790");
   string part[];
   ArrayResize(part, 1); for(int i = 0; i < 1; i++) part[i] = leaves[i];
   Expect("root 1", VcpMerkleRoot(part), "13a77175e35eb1d9da91ee14df0d7772cea71289800206e2b45c882ecb06efbf");
   ArrayResize(part, 2); for(int i = 0; i < 2; i++) part[i] = leaves[i];

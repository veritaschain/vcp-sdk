   //--- CVcpWriter
   {
   string pre = "vcp_selftest-";
   string d23 = pre + "20261023.jsonl", d24 = pre + "20261024.jsonl", d25 = pre + "20261025.jsonl", odd = pre + "x-20261024.jsonl";
   FileDelete(d23); FileDelete(d24); FileDelete(d25); FileDelete(odd);
   CVcpWriter w;
   ExpectTrue("writer open", w.Open(d23, "actor-example", "chain-001", "org.veritaschain.sdk:test-vectors", 9, true));
   ExpectTrue("writer starts empty", w.NextSequence() == 0 && w.LastHash() == "");
   CVcpJson *j1001 = VcpObj();
   CVcpJson *j1002 = VcpObj();
   j1002.Put("AlgoID", VcpStr("example-ea"));
